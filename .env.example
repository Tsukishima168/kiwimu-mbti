# kiwimu-com 環境變數基準檔
# 由 chore/kiwimu-env-baseline 分支建立（grep 全庫 import.meta.env.* / process.env.* 產生，2026-07-30）。
# 只列變數名與用途，不含任何真實值。標註「本機」＝ npm run dev/build 或本地手動跑 script/discord-bot 會用到；
# 「僅 Vercel」＝ 只在部署環境出現，本機 .env* 未設定（多半有安全預設或屬於未使用/legacy 功能，見備註）。

# ── Supabase：Auth / User DB（client，Vite build-time 注入）────────────────────
VITE_MOON_ISLAND_SUPABASE_URL=            # 本機｜Moon Island Supabase 專案 URL（SSO/user-client 主要來源，優先於 VITE_SUPABASE_USER_URL）
VITE_MOON_ISLAND_SUPABASE_ANON_KEY=       # 本機｜對應上面專案的 anon key（utils/supabaseAuthBridge.ts 建 client 用，非 service_role）
VITE_SUPABASE_USER_URL=                   # 本機｜同上的 fallback URL（歷史命名，MOON_ISLAND 版本優先）
VITE_SUPABASE_USER_ANON_KEY=              # 本機｜同上的 fallback anon key

# ── Supabase：Server-side（Vercel Functions / server 腳本，需 service_role）────
SUPABASE_USER_URL=                        # 本機｜user-admin / notify-discord 等 server 端讀取的 user DB URL
SUPABASE_USER_SERVICE_ROLE_KEY=           # 本機｜對應上面的 service_role key（server 專用，切勿進 client bundle）
SUPABASE_SERVICE_ROLE_KEY=                # 本機｜economy admin client 的 service_role key（fallback 用途也有）
SUPABASE_URL=                             # 僅 Vercel｜legacy 遷移腳本 fallback（supabase/scripts/migrate-data.ts），一般用 VITE_SUPABASE_URL 或 SUPABASE_USER_URL
SUPABASE_PROJECT_REF=                     # 僅 Vercel｜economy admin client 用的 Supabase project ref
SUPABASE_USER_PROJECT_REF=                # 僅 Vercel｜同上，user DB 專案 ref

# ── LINE Pay（server/linePay.ts）───────────────────────────────────────────────
LINE_PAY_BASE_URL=                        # 本機｜LINE Pay API base（未設定時預設 sandbox）
LINE_PAY_API_VERSION=                     # 本機｜LINE Pay API 版本（未設定預設 v3）
LINE_PAY_CHANNEL_ID=                      # 本機｜LINE Pay channel id
LINE_PAY_CHANNEL_SECRET=                  # 本機｜LINE Pay channel secret

# ── Discord：通知 / 互動 / Bot（api/、discord-bot/、scripts/）─────────────────
DISCORD_TOKEN=                            # 本機｜Discord bot token（discord-bot/ 腳本、notify-discord fallback 共用）
DISCORD_BOT_TOKEN=                        # 本機｜同上（api/notify-discord.ts 優先讀 DISCORD_TOKEN，此為次選）
DISCORD_APPLICATION_ID=                   # 本機｜Discord application id（scripts/register-discord-commands.ts 註冊 slash command 用）
DISCORD_CLIENT_ID=                        # 僅 Vercel｜discord-bot/index.js 邀請連結用的 client id
DISCORD_GUILD_ID=                         # 本機｜Discord 伺服器 (guild) id
DISCORD_PUBLIC_KEY=                       # 本機｜驗證 Discord interaction 簽章用的 public key
DISCORD_CHANNEL_ID=                       # 僅 Vercel｜結果通知頻道 id（code 內有硬編預設值）
DISCORD_DETAIL_CHANNEL_ID=                # 僅 Vercel｜詳細版通知頻道 id（未設會 fallback 到 EVENTS/CHANNEL_ID）
DISCORD_EVENTS_CHANNEL_ID=                # 僅 Vercel｜事件頻道 id（DETAIL_CHANNEL_ID 的 fallback 來源）
DISCORD_LINK_BASE_URL=                    # 僅 Vercel｜interaction 回覆連結的 base URL（預設 https://kiwimu.com）
DISCORD_REPORT_BASE_URL=                  # 僅 Vercel｜報告頁連結的 base URL（預設 https://kiwimu.com）

# ── 站台跨連結 / 外部 API（client，Vite build-time 注入）───────────────────────
VITE_DISCORD_WEBHOOK_URL=                 # 僅 Vercel｜前端直接發送 Discord webhook 通知（utils/discordWebhook.ts）
VITE_LINE_LIFF_ID=                        # 僅 Vercel｜LINE LIFF 分享功能用的 LIFF app id
VITE_PASSPORT_URL=                        # 僅 Vercel｜Passport 站點 base URL（預設 https://kiwimu.com/passport）
VITE_SHOP_MENU_RESOLVE_URL=               # 僅 Vercel｜Shop 菜單解析 API URL（前端 fallback 用）
VITE_UNIFIED_DESSERT_API_URL=             # 僅 Vercel｜統一甜點資料 API URL

# ── 甜點/菜單解析（server，api/mbti-dessert.ts）────────────────────────────────
SHOP_MENU_MBTI_API_URL=                   # 僅 Vercel｜Shop MBTI 甜點 API（server 端 upstream）
SHOP_MENU_RESOLVE_URL=                    # 僅 Vercel｜Shop 菜單解析 API（server 端 upstream）

# ── Email（api/send-email.ts，Resend）──────────────────────────────────────────
RESEND_API_KEY=                           # 僅 Vercel｜Resend 寄信 API key
EMAIL_FROM=                               # 僅 Vercel｜寄件 From 地址（未設有預設值）

# ── AI（vite.config.ts define，注入 Gemini）────────────────────────────────────
GEMINI_API_KEY=                           # 本機｜Google Gemini API key
API_KEY=                                  # 本機｜vite.config.ts 內部別名，值＝GEMINI_API_KEY，不需另外設定，僅列出供對照

# ── Legacy / 疑似未使用（保留於 .env* 但目前程式碼路徑罕見）────────────────────
FIREBASE_SERVICE_ACCOUNT=                 # 僅 Vercel｜api/save-user.ts 讀取 Firebase service account JSON（專案已轉 Supabase-only，此路徑疑似 legacy）
GOOGLE_SHEET_ID=                          # 本機｜api/save-user.ts 寫入的 Google Sheet id（同上，legacy 存疑）

# ── 站內營運腳本 App base URL ───────────────────────────────────────────────────
APP_BASE_URL=                             # 本機｜server/linePay.ts 組 callback URL 用（未設會 fallback 到 request origin 或 localhost:5173）

# ── Google Search Console / GA4 自動化腳本（scripts/google-stack/）────────────
GOOGLE_STACK_CONFIG=                      # 本機｜google-stack 腳本設定檔路徑（預設 repo 內 google-stack.config.json）
GOOGLE_STACK_CLIENT_ID_FILE=              # 本機｜OAuth client id 檔案路徑（有預設路徑，選填）
GOOGLE_STACK_TOKEN_FILE=                  # 本機｜OAuth token 快取檔案路徑（有預設路徑，選填）
GOOGLE_STACK_START_DATE=                  # 本機｜GSC 報表起始日（選填，預設自動算 30 天前）
GOOGLE_STACK_END_DATE=                    # 本機｜GSC 報表結束日（選填，預設自動算 2 天前）

# ── 內容產製腳本（scripts/generate-v2-*.mjs，本機手動執行用）───────────────────
V2_TW_QUESTION_FILE=                      # 本機｜v2 台灣版題庫來源 md 檔路徑（選填，有預設 Obsidian 路徑）
V2_TW_DRAFT_DIR=                          # 本機｜v2 台灣版草稿輸出目錄（選填）
V2_TW_VARIANT_DIR=                        # 本機｜v2 variant 報告輸出目錄（選填）
KIWIMU_OBSIDIAN_ROOT=                     # 本機｜Kiwimu Obsidian vault 根目錄（選填，有預設路徑，供內容同步腳本用）
PENSO_OBSIDIAN_ROOT=                      # 本機｜Penso-SSOT Obsidian vault 根目錄（選填，有預設路徑，供內容同步腳本用）

# ── 手動測試腳本（scripts/test-discord-endpoint.ts，選填）──────────────────────
ENDPOINT_URL=                             # 本機｜手動測試 Discord interaction endpoint 時覆蓋目標 URL（預設 localhost:3000）
