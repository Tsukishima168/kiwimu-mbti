{
    "headers": [
        {
            "source": "/assets/:file([^/]+-[A-Za-z0-9_-]{8}\\.(?:js|css))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api(?:/|$)|assets(?:/|$)).*)",
            "destination": "/index.html"
        }
    ]
}
