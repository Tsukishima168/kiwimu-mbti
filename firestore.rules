rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read/write their own quiz progress
    // Progress document ID format: {uid}_{quizVersion}
    match /quiz_progress/{progressId} {
      allow read, write: if request.auth != null && 
                            progressId.matches('^' + request.auth.uid + '_.*');
    }
    
    // Users can read/write their own test runs
    // Public can read test runs marked as public
    match /test_runs/{runId} {
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) ||
                     (resource.data.isPublic == true);
      allow write: if request.auth != null && 
                      resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && 
                       request.resource.data.uid == request.auth.uid;
    }

    // User behaviors logging
    match /user_behaviors/{behaviorId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Allow reading only own behaviors if needed, or restricting it. 
      // For now, let's allow read for owner
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // User stats
    match /user_stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Anyone can read share links (needed for public sharing)
    match /share_links/{shareId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
  }
}
