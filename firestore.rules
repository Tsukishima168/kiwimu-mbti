rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read/write their own quiz progress
    // Progress document ID format: {uid}_{quizVersion}
    match /quiz_progress/{progressId} {
      allow read, write: if request.auth != null && 
                            progressId.matches('^' + request.auth.uid + '_.*');
    }
    
    // Users can read/write their own test runs
    match /test_runs/{runId} {
      allow read: if request.auth != null && 
                     resource.data.uid == request.auth.uid;
      allow write: if request.auth != null && 
                      resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && 
                       request.resource.data.uid == request.auth.uid;
    }
  }
}
