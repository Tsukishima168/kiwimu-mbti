{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    ".claude",
    "dist",
    "MBTI-Lab-V1.5-TEST",
    "docs",
    "obsidian",
    "supabase/.temp",
    "supabase/scripts",
    "scripts",
    "api",
    "**/* 2.ts",
    "**/* 2.tsx",
    "**/* 2.css",
    "**/llms 2.txt"
  ]
}
